{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  /**
   * Configuration Vercel — Étape 6
   *
   * Déploiement, CI/CD, variables d'environnement, et règles de performance
   */

  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",

  "env": {
    "NEXT_PUBLIC_FIREBASE_API_KEY": "@firebase-api-key",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "@firebase-auth-domain",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "@firebase-project-id",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "@firebase-storage-bucket",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "@firebase-messaging-sender-id",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "@firebase-app-id"
  },

  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": false
    }
  },

  /**
   * En-têtes de sécurité et performance
   */
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],

  /**
   * Redirections (optionnel)
   */
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ],

  /**
   * Réécriture d'URL
   */
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/public/robots.txt"
    }
  ],

  /**
   * Fonctions (Serverless Functions)
   */
  "functions": {
    "src/app/api/**": {
      "maxDuration": 60
    }
  },

  /**
   * Preview Deployments
   */
  "env": {
    "preview": {
      "NEXT_PUBLIC_SITE_URL": "@preview-url"
    },
    "production": {
      "NEXT_PUBLIC_SITE_URL": "https://moulinvertbeja.tn"
    }
  }
}
