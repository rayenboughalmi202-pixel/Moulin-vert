# Configuration Firebase (client) — Moulin Vert Béja
#
# 1. Créez un projet sur https://console.firebase.google.com
# 2. Ajoutez une application Web au projet
# 3. Activez Firestore Database (mode production)
# 4. Activez Authentication → Sign-in method → "E-mail/Mot de passe"
# 5. Dans Authentication → Users, créez un compte pour chaque membre de
#    l'équipe autorisé à se connecter sur /admin (aucune inscription
#    publique n'existe volontairement dans le site)
# 6. Copiez ce fichier en ".env.local" et collez les valeurs de votre projet
# 7. Déployez les règles de sécurité fournies dans firestore.rules
#
# Ces clés sont publiques par nature (préfixe NEXT_PUBLIC_) : la sécurité
# réelle des données est assurée par les règles Firestore et par
# Firebase Authentication, pas par le secret de ces valeurs.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAQc1MNzqn8xH6DzXjUWpug5HsIdj1wnsA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=moulin-vert-96ba0.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=moulin-vert-96ba0
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=moulin-vert-96ba0.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=174167334095
NEXT_PUBLIC_FIREBASE_APP_ID=1:174167334095:web:a0812856aaaaafef3cebba
